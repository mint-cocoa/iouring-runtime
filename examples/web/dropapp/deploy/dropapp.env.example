# Listener
DROPAPP_HOST=0.0.0.0
DROPAPP_PORT=3000

# Storage
DROPAPP_ROOT=/data
DROPAPP_STATIC_ROOT=/usr/share/dropapp/static
DROPAPP_DEFAULT_TTL_SECONDS=3600
DROPAPP_MAX_UPLOAD_BYTES=104857600
DROPAPP_SEND_CHUNK_BYTES=262144

# Optional. If empty, uploads and deletes are not protected.
# Use Authorization: Bearer <token> for upload/delete requests.
DROPAPP_AUTH_TOKEN=

# Runtime tuning
DROPAPP_LOG_LEVEL=info
DROPAPP_WORKERS=1
DROPAPP_WORKER_AFFINITY=physical
DROPAPP_MAX_SESSIONS_PER_WORKER=0
DROPAPP_RING_QUEUE_DEPTH=2048
DROPAPP_RING_BUF_COUNT=4096
DROPAPP_RING_BUF_SIZE=8192
DROPAPP_RING_SUBMIT_BATCH=1
DROPAPP_RING_CQE_BATCH_BUDGET=0
DROPAPP_RING_IO_TIMEOUT_MS=1
DROPAPP_INACTIVITY_TIMEOUT_MS=60000
DROPAPP_REQUEST_TIMEOUT_MS=120000
DROPAPP_SEND_QUEUE_MAX_PENDING=4096
DROPAPP_SEND_QUEUE_HIGH_WATERMARK=0
DROPAPP_SEND_QUEUE_LOW_WATERMARK=0
DROPAPP_DISCONNECT_ON_HIGH_WATERMARK=0
