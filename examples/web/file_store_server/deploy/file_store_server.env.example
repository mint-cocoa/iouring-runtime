# Listener
FILE_STORE_HOST=127.0.0.1
FILE_STORE_PORT=3012

# Storage
FILE_STORE_ROOT=/var/lib/iouring-runtime/files
FILE_STORE_MAX_UPLOAD_BYTES=268435456
FILE_STORE_SEND_CHUNK_BYTES=262144

# Optional. If empty, writes and deletes are not protected.
# Use Authorization: Bearer <token> for upload/delete requests.
FILE_STORE_AUTH_TOKEN=

# Runtime tuning
FILE_STORE_LOG_LEVEL=info
FILE_STORE_WORKERS=1
FILE_STORE_WORKER_AFFINITY=physical
FILE_STORE_MAX_SESSIONS_PER_WORKER=0
FILE_STORE_RING_QUEUE_DEPTH=2048
FILE_STORE_RING_BUF_COUNT=4096
FILE_STORE_RING_BUF_SIZE=8192
FILE_STORE_RING_SUBMIT_BATCH=1
FILE_STORE_RING_CQE_BATCH_BUDGET=0
FILE_STORE_RING_IO_TIMEOUT_MS=1
FILE_STORE_INACTIVITY_TIMEOUT_MS=60000
FILE_STORE_REQUEST_TIMEOUT_MS=120000
FILE_STORE_SEND_QUEUE_MAX_PENDING=4096
FILE_STORE_SEND_QUEUE_HIGH_WATERMARK=0
FILE_STORE_SEND_QUEUE_LOW_WATERMARK=0
FILE_STORE_DISCONNECT_ON_HIGH_WATERMARK=0
