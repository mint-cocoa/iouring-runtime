# Listener
STATUS_HOST=127.0.0.1
STATUS_PORT=3010
STATUS_PROXY_METRICS_FILE=/run/iouring-runtime/tcp_reverse_proxy.metrics.json

# Runtime tuning
STATUS_LOG_LEVEL=info
STATUS_WORKERS=1
STATUS_WORKER_AFFINITY=physical
STATUS_MAX_SESSIONS_PER_WORKER=0
STATUS_RING_QUEUE_DEPTH=256
STATUS_RING_BUF_COUNT=256
STATUS_RING_BUF_SIZE=8192
STATUS_RING_IO_TIMEOUT_MS=1000
STATUS_INACTIVITY_TIMEOUT_MS=30000
STATUS_REQUEST_TIMEOUT_MS=2000
