# Listener
SPEEDTEST_HOST=127.0.0.1
SPEEDTEST_PORT=3004

# OpenSpeedTest static files. Install examples/web/speedtest_server/public here.
SPEEDTEST_STATIC_ROOT=/usr/local/share/iouring-runtime/openspeedtest

# Test payloads
SPEEDTEST_DOWNLOAD_BYTES=31457280
SPEEDTEST_DOWNLOAD_CHUNK_BYTES=1048576
SPEEDTEST_MAX_UPLOAD_BYTES=67108864
SPEEDTEST_MAX_STATIC_FILE_BYTES=8388608

# Runtime tuning
SPEEDTEST_LOG_LEVEL=info
SPEEDTEST_WORKERS=1
SPEEDTEST_WORKER_AFFINITY=physical
SPEEDTEST_MAX_SESSIONS_PER_WORKER=0
SPEEDTEST_RING_QUEUE_DEPTH=2048
SPEEDTEST_RING_BUF_COUNT=4096
SPEEDTEST_RING_BUF_SIZE=8192
SPEEDTEST_RING_SUBMIT_BATCH=1
SPEEDTEST_RING_CQE_BATCH_BUDGET=0
SPEEDTEST_RING_IO_TIMEOUT_MS=1
SPEEDTEST_INACTIVITY_TIMEOUT_MS=60000
SPEEDTEST_REQUEST_TIMEOUT_MS=60000
SPEEDTEST_SEND_QUEUE_MAX_PENDING=4096
SPEEDTEST_SEND_QUEUE_HIGH_WATERMARK=0
SPEEDTEST_SEND_QUEUE_LOW_WATERMARK=0
SPEEDTEST_DISCONNECT_ON_HIGH_WATERMARK=0
