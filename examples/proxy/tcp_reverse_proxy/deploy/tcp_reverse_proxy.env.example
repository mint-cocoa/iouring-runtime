# Proxy listener
TCP_PROXY_LOG_LEVEL=info
TCP_PROXY_LISTEN_HOST=0.0.0.0
TCP_PROXY_LISTEN_PORT=443

# Upstream runtime application
TCP_PROXY_UPSTREAM_HOST=127.0.0.1
TCP_PROXY_UPSTREAM_PORT=8080
# Optional SNI routes for TLS traffic. First match wins; the default upstream
# above is used when no route matches.
# TCP_PROXY_UPSTREAM_ROUTES=app.example.com=127.0.0.1:3001,*.example.com=127.0.0.1:3002

# Let's Encrypt live certificate files.
# Leave these empty until the first certificate has been issued.
TCP_PROXY_TLS_CERT_FILE=
TCP_PROXY_TLS_KEY_FILE=

# ACME HTTP-01 challenge listener for certbot --webroot
TCP_PROXY_CERTBOT_CHALLENGE_HOST=0.0.0.0
TCP_PROXY_CERTBOT_CHALLENGE_PORT=80
TCP_PROXY_CERTBOT_CHALLENGE_WEBROOT=/var/lib/letsencrypt

# Proxy tuning
TCP_PROXY_WORKERS=1
TCP_PROXY_WORKER_AFFINITY=physical
TCP_PROXY_CONNECT_TIMEOUT_MS=3000
TCP_PROXY_INACTIVITY_TIMEOUT_MS=30000
TCP_PROXY_PENDING_CONNECT_BUFFER_LIMIT=262144
TCP_PROXY_SEND_QUEUE_MAX_PENDING=4096

# Helper values used by the deploy scripts below. The proxy binary ignores them.
TCP_PROXY_CERTBOT_DOMAIN=example.com
TCP_PROXY_CERTBOT_EXTRA_DOMAINS=
TCP_PROXY_CERTBOT_EMAIL=admin@example.com
TCP_PROXY_SYSTEMD_SERVICE=tcp_reverse_proxy.service
CERTBOT_BIN=certbot
