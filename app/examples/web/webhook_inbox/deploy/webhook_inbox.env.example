# Listener
WEBHOOK_INBOX_HOST=0.0.0.0
WEBHOOK_INBOX_PORT=3000

# Storage
WEBHOOK_INBOX_ROOT=/data
WEBHOOK_INBOX_STATIC_ROOT=/usr/share/webhook-inbox/static
WEBHOOK_INBOX_DEFAULT_TTL_SECONDS=86400
WEBHOOK_INBOX_MAX_BODY_BYTES=10485760

# Optional. If empty, API reads and deletes are not protected.
# Capture endpoints under /hooks/github, /hooks/argocd, and /hook/<inbox>
# remain public.
WEBHOOK_INBOX_AUTH_TOKEN=

# Runtime tuning
WEBHOOK_INBOX_LOG_LEVEL=info
WEBHOOK_INBOX_WORKERS=1
WEBHOOK_INBOX_WORKER_AFFINITY=physical
WEBHOOK_INBOX_INACTIVITY_TIMEOUT_MS=60000
WEBHOOK_INBOX_REQUEST_TIMEOUT_MS=120000
