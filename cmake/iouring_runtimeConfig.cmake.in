@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(URING REQUIRED IMPORTED_TARGET liburing)

include("${CMAKE_CURRENT_LIST_DIR}/@IORUNTIME_PACKAGE_NAME@Targets.cmake")

if(NOT TARGET iouring::Runtime AND TARGET @IORUNTIME_PACKAGE_NAME@::Runtime)
    add_library(iouring::Runtime INTERFACE IMPORTED)
    set_property(TARGET iouring::Runtime PROPERTY
        INTERFACE_LINK_LIBRARIES @IORUNTIME_PACKAGE_NAME@::Runtime)
endif()

if(NOT TARGET iouring::RuntimeObservability AND TARGET @IORUNTIME_PACKAGE_NAME@::RuntimeObservability)
    add_library(iouring::RuntimeObservability INTERFACE IMPORTED)
    set_property(TARGET iouring::RuntimeObservability PROPERTY
        INTERFACE_LINK_LIBRARIES @IORUNTIME_PACKAGE_NAME@::RuntimeObservability)
endif()

if(NOT TARGET iouring::RuntimeMedia AND TARGET @IORUNTIME_PACKAGE_NAME@::RuntimeMedia)
    add_library(iouring::RuntimeMedia INTERFACE IMPORTED)
    set_property(TARGET iouring::RuntimeMedia PROPERTY
        INTERFACE_LINK_LIBRARIES @IORUNTIME_PACKAGE_NAME@::RuntimeMedia)
endif()
